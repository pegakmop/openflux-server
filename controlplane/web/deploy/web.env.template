# Template for /etc/openflux/web.env (openflux-web.service EnvironmentFile).
# Copy to the host, fill in, keep readable only by the openflux user.

# Go controlplane this panel talks to (dev default). In http-mode (no Nginx)
# /v1/* request are proxied here; with the recommended Nginx split this is
# still used as the fallback path.
CONTROLPLANE_UPSTREAM=http://127.0.0.1:8080

# Address the panel binds. Loopback + a front proxy is the recommended setup.
CONTROLPLANE_WEB_HOST=127.0.0.1
CONTROLPLANE_WEB_PORT=3000