# Where the Go controlplane API lives. Dev default is http://127.0.0.1:8080
# (used by the vite proxy). The production `bun server.js` entry forwards
# /v1/* and /healthz here too, which matters for http-mode deployments
# without nginx.
CONTROLPLANE_UPSTREAM=http://127.0.0.1:8080

# Address the web server binds (bun server.js). Defaults shown are production
# defaults; nginx (or another reverse proxy) fronts this process.
CONTROLPLANE_WEB_HOST=127.0.0.1
CONTROLPLANE_WEB_PORT=3000